>{    fields: [{      key: 'bla', // should be OK: Not excess      value: null,    }],  } : { fields: Array<{ key: string; value: null; }>; }

    fields: [{
>fields : Array<{ key: string; value: null; }>
>[{      key: 'bla', // should be OK: Not excess      value: null,    }] : Array<{ key: string; value: null; }>
>{      key: 'bla', // should be OK: Not excess      value: null,    } : { key: string; value: null; }

