// TODO: remove lib hack when https://github.com/Microsoft/TypeScript/issues/20454 is fixed
type Fn<T extends object> = <U extends T>(subj: U) => U
>Fn : Fn<T>
>subj : U

function doStuff<T extends object, T1 extends T>(a: Array<Fn<T>>, b: Array<Fn<T1>>) {
>doStuff : <T extends object, T1 extends T>(a: Array<Fn<T>>, b: Array<Fn<T1>>) => void
>a : Array<Fn<T>>
>b : Array<Fn<T1>>

    b.concat(a);
>b.concat(a) : Array<Fn<T1>>
>b.concat : { (...items: Array<ConcatArray<Fn<T1>>>): Array<Fn<T1>>; (...items: Array<ConcatArray<Fn<T1>> | Fn<T1>>): Array<Fn<T1>>; }
>b : Array<Fn<T1>>
>concat : { (...items: Array<ConcatArray<Fn<T1>>>): Array<Fn<T1>>; (...items: Array<ConcatArray<Fn<T1>> | Fn<T1>>): Array<Fn<T1>>; }
>a : Array<Fn<T>>
}

