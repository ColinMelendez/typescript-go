//// [tests/cases/compiler/arrayOfSubtypeIsAssignableToReadonlyArray.ts] ////

=== arrayOfSubtypeIsAssignableToReadonlyArray.ts ===
class A { a }
>A : A
>a : any

class B extends A { b }
>B : B
>A : A
>b : any

class C<T> extends Array<T> { c }
>C : C<T>
>Array : Array<T>
>c : any

declare var ara: A[];
>ara : Array<A>

declare var arb: B[];
>arb : Array<B>

declare var cra: C<A>;
>cra : C<A>

declare var crb: C<B>;
>crb : C<B>

declare var rra: ReadonlyArray<A>;
>rra : ReadonlyArray<A>

declare var rrb: ReadonlyArray<B>;
>rrb : ReadonlyArray<B>

rra = ara;
>rra = ara : Array<A>
>rra : ReadonlyArray<A>
>ara : Array<A>

rrb = arb; // OK, Array<B> is assignable to ReadonlyArray<A>
>rrb = arb : Array<B>
>rrb : ReadonlyArray<B>
>arb : Array<B>

rra = arb;
>rra = arb : Array<B>
>rra : ReadonlyArray<A>
>arb : Array<B>

rrb = ara; // error: 'A' is not assignable to 'B'
>rrb = ara : Array<A>
>rrb : ReadonlyArray<B>
>ara : Array<A>

rra = cra;
>rra = cra : C<A>
>rra : ReadonlyArray<A>
>cra : C<A>

rra = crb; // OK, C<B> is assignable to ReadonlyArray<A>
>rra = crb : C<B>
>rra : ReadonlyArray<A>
>crb : C<B>

rrb = crb;
>rrb = crb : C<B>
>rrb : ReadonlyArray<B>
>crb : C<B>

rrb = cra; // error: 'A' is not assignable to 'B'
>rrb = cra : C<A>
>rrb : ReadonlyArray<B>
>cra : C<A>

