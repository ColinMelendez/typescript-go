// change the shape of Array<T>
import {A} from "./f1";
>A : typeof A

declare global {
>global : any

    interface Array<T> {
        getCountAsString(): string;
>getCountAsString : () => string
    }
}

let x = [1];
>x : Array<number>
>[1] : Array<number>
>1 : 1

let y = x.getCountAsString().toLowerCase();
>y : string
>x.getCountAsString().toLowerCase() : string
>x.getCountAsString().toLowerCase : () => string
>x.getCountAsString() : string
>x.getCountAsString : () => string
