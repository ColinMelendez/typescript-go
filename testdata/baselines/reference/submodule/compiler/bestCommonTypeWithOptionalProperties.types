//// [tests/cases/compiler/bestCommonTypeWithOptionalProperties.ts] ////

=== bestCommonTypeWithOptionalProperties.ts ===
interface X { foo: string }
>foo : string

interface Y extends X { bar?: number }
>bar : number | undefined

interface Z extends X { bar: string }
>bar : string

var x: X;
>x : X

var y: Y;
>y : Y

var z: Z;
>z : Z

// All these arrays should be X[]
var b1 = [x, y, z];
>b1 : Array<X>
>[x, y, z] : Array<X>
>x : X
>y : Y
>z : Z

var b2 = [x, z, y];
>b2 : Array<X>
>[x, z, y] : Array<X>
>x : X
>z : Z
>y : Y

var b3 = [y, x, z];
>b3 : Array<X>
>[y, x, z] : Array<X>
>y : Y
>x : X
>z : Z

var b4 = [y, z, x];
>b4 : Array<X>
>[y, z, x] : Array<X>
>y : Y
>z : Z
>x : X

var b5 = [z, x, y];
>b5 : Array<X>
>[z, x, y] : Array<X>
>z : Z
>x : X
>y : Y

var b6 = [z, y, x];
>b6 : Array<X>
>[z, y, x] : Array<X>
>z : Z
>y : Y
>x : X

