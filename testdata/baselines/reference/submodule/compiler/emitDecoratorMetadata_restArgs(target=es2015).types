=== emitDecoratorMetadata_restArgs.ts ===
declare const MyClassDecorator: ClassDecorator;
>MyClassDecorator : ClassDecorator

declare const MyMethodDecorator: MethodDecorator;
>MyMethodDecorator : MethodDecorator

@MyClassDecorator
>MyClassDecorator : ClassDecorator

class A {
>A : A

    constructor(...args) {}
>args : Array<any>

    @MyMethodDecorator
>MyMethodDecorator : MethodDecorator

    method(...args) {}
>method : (...args: Array<any>) => void
>args : Array<any>
}

@MyClassDecorator
>MyClassDecorator : ClassDecorator

class B {
>B : B

    constructor(...args: number[]) {}
>args : Array<number>

    @MyMethodDecorator
>MyMethodDecorator : MethodDecorator

    method(this: this, ...args: string[]) {}
>method : (this: this, ...args: string[]) => void
>this : this
>args : Array<string>
}

