// Example from #6037

function fold<a, r>(values: a[], result: r, fold: (result: r, value: a) => r): r {
>fold : <a, r>(values: a[], result: r, fold: (result: r, value: a) => r) => r
>values : Array<a>
>result : r
>fold : (result: r, value: a) => r
>result : r
>value : a

    for (let value of values) {
>value : a
>values : Array<a>

        result = fold(result, value);
>result = fold(result, value) : r
>result : r
>fold(result, value) : r
>fold : (result: r, value: a) => r
>result : r
>value : a
    }
    return result;
>result : r
}

function append<a, b extends a>(values: a[], value: b): a[] {
>append : <a, b extends a>(values: a[], value: b) => a[]
>values : Array<a>
>value : b

    values.push(value);
>values.push(value) : number
>values.push : (...items: Array<a>) => number
>values : Array<a>
>push : (...items: Array<a>) => number
>value : b

    return values;
>values : Array<a>
}

fold(
>fold(    [1, 2, 3],    [] as [string, string][],    (result, value) => append(        result,        ["", ""]    )) : Array<[string, string]>
>fold : <a, r>(values: a[], result: r, fold: (result: r, value: a) => r) => r

    [1, 2, 3],
>[1, 2, 3] : Array<number>
>1 : 1
>2 : 2
>3 : 3

    [] as [string, string][],
>[] as [string, string][] : Array<[string, string]>
>[] : Array<never>

    (result, value) => append(
>(result, value) => append(        result,        ["", ""]    ) : (result: Array<[string, string]>, value: number) => Array<[string, string]>
>result : Array<[string, string]>
>value : number
>append(        result,        ["", ""]    ) : Array<[string, string]>
>append : <a, b extends a>(values: a[], value: b) => a[]

        result,
>result : Array<[string, string]>

        ["", ""]
>["", ""] : [string, string]
>"" : ""
>"" : ""

    )
);

