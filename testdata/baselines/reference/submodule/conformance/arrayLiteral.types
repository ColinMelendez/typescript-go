//// [tests/cases/conformance/types/specifyingTypes/typeLiterals/arrayLiteral.ts] ////

=== arrayLiteral.ts ===
// valid uses of array literals

var x = [];
>x : Array<any>
>[] : Array<never>

var x = new Array(1);
>x : Array<any>
>new Array(1) : Array<any>
>Array : ArrayConstructor
>1 : 1

var y = [1];
>y : Array<number>
>[1] : Array<number>
>1 : 1

var y = [1, 2];
>y : Array<number>
>[1, 2] : Array<number>
>1 : 1
>2 : 2

var y = new Array<number>();
>y : Array<number>
>new Array<number>() : Array<number>
>Array : ArrayConstructor

var x2: number[] = [];
>x2 : Array<number>
>[] : Array<never>

var x2: number[] = new Array(1);
>x2 : Array<number>
>new Array(1) : Array<any>
>Array : ArrayConstructor
>1 : 1

var y2: number[] = [1];
>y2 : Array<number>
>[1] : Array<number>
>1 : 1

var y2: number[] = [1, 2];
>y2 : Array<number>
>[1, 2] : Array<number>
>1 : 1
>2 : 2

var y2: number[] = new Array<number>();
>y2 : Array<number>
>new Array<number>() : Array<number>
>Array : ArrayConstructor

