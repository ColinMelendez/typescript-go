//// [tests/cases/conformance/es6/destructuring/restElementWithInitializer2.ts] ////

=== restElementWithInitializer2.ts ===
declare var a: number[];
>a : Array<number>

var x: number[];
>x : Array<number>

[...x = a] = a;  // Error, rest element cannot have initializer
>[...x = a] = a : Array<number>
>[...x = a] : Array<number>
>...x = a : number
>x = a : Array<number>
>x : Array<number>
>a : Array<number>
>a : Array<number>

