// Repro from #19682

type Nominal<Kind extends string, Type> = Type & {
>Nominal : Nominal<Kind, Type>

    [Symbol.species]: Kind;
>[Symbol.species] : Kind
>Symbol.species : unique symbol
>Symbol : SymbolConstructor
>species : unique symbol

};

type A = Nominal<'A', string>;
>A : A

declare const a: Set<A>;
>a : Set<A>

declare const b: Set<A>;
>b : Set<A>

const c1 = Array.from(a).concat(Array.from(b));
>c1 : Array<A>
>Array.from(a).concat(Array.from(b)) : Array<A>
>Array.from(a).concat : { (...items: Array<ConcatArray<A>>): Array<A>; (...items: Array<ConcatArray<A> | A>): Array<A>; }
>Array.from(a) : Array<A>
