//// [tests/cases/conformance/types/typeRelationships/widenedTypes/arrayLiteralWidened.ts] ////

=== arrayLiteralWidened.ts ===
// array literals are widened upon assignment according to their element type

var a = []; // any[]
>a : Array<any>
>[] : Array<undefined>

var a = [,,];
>a : Array<any>
>[,,] : Array<undefined>

var a = [null, null];
>a : Array<any>
>[null, null] : Array<null>

var a = [undefined, undefined];
>a : Array<any>
>[undefined, undefined] : Array<undefined>
>undefined : undefined
>undefined : undefined

var b = [[], [null, null]]; // any[][]
>b : Array<Array<any>>
>[[], [null, null]] : Array<Array<undefined>>
>[] : Array<undefined>
>[null, null] : Array<null>

var b = [[], []];
>b : Array<Array<any>>
>[[], []] : Array<Array<undefined>>
>[] : Array<undefined>
>[] : Array<undefined>

var b = [[undefined, undefined]];
>b : Array<Array<any>>
>[[undefined, undefined]] : Array<Array<undefined>>
>[undefined, undefined] : Array<undefined>
>undefined : undefined
>undefined : undefined

var c = [[[]]]; // any[][][]
>c : Array<Array<Array<any>>>
>[[[]]] : Array<Array<Array<undefined>>>
>[[]] : Array<Array<undefined>>
>[] : Array<undefined>

var c = [[[null]],[undefined]]
>c : Array<Array<Array<any>>>
>[[[null]],[undefined]] : Array<Array<Array<null>>>
>[[null]] : Array<Array<null>>
>[null] : Array<null>
>[undefined] : Array<undefined>
>undefined : undefined

// no widening when one or more elements are non-widening

var x: undefined = undefined;
>x : undefined
>undefined : undefined

var d = [x];
>d : Array<undefined>
>[x] : Array<undefined>
>x : undefined

var d = [, x];
>d : Array<undefined>
>[, x] : Array<undefined>
>x : undefined

var d = [undefined, x];
>d : Array<undefined>
>[undefined, x] : Array<undefined>
>undefined : undefined
>x : undefined

