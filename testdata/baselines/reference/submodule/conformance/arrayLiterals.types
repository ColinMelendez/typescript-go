//// [tests/cases/conformance/expressions/arrayLiterals/arrayLiterals.ts] ////

=== arrayLiterals.ts ===
// Empty array literal with no contextual type has type Undefined[]

var arr1= [[], [1], ['']];
>arr1 : Array<Array<string> | Array<number>>
>[[], [1], ['']] : Array<Array<string> | Array<number>>
>[] : Array<undefined>
>[1] : Array<number>
>1 : 1
>[''] : Array<string>
>'' : ""

var arr2 = [[null], [1], ['']];
>arr2 : Array<Array<string> | Array<number>>
>[[null], [1], ['']] : Array<Array<string> | Array<number>>
>[null] : Array<null>
>[1] : Array<number>
>1 : 1
>[''] : Array<string>
>'' : ""


// Array literal with elements of only EveryType E has type E[]
var stringArrArr = [[''], [""]];
>stringArrArr : Array<Array<string>>
>[[''], [""]] : Array<Array<string>>
>[''] : Array<string>
>'' : ""
>[""] : Array<string>
>"" : ""

var stringArr = ['', ""];
>stringArr : Array<string>
>['', ""] : Array<string>
>'' : ""
>"" : ""

var numberArr = [0, 0.0, 0x00, 1e1];
>numberArr : Array<number>
>[0, 0.0, 0x00, 1e1] : Array<number>
>0 : 0
>0.0 : 0
>0x00 : 0
>1e1 : 10

var boolArr = [false, true, false, true];
>boolArr : Array<boolean>
>[false, true, false, true] : Array<boolean>
>false : false
>true : true
>false : false
>true : true

class C { private p; }
>C : C
>p : any

