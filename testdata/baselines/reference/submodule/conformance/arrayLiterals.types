>a : string
>'' : ""
>b : number
>0 : 0
>c : string
>'' : ""
>{ a: "", b: 3, c: 0 } : { a: string; b: number; c: number; }
>a : string
>"" : ""
>b : number
>3 : 3
>c : number
>0 : 0

